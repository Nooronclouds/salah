# Copy to ".env" and fill in. Never commit the real .env.

# Twilio (same account as the poc). Server-side only — never sent to the app.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567

# Shared secret the app must send as "Authorization: Bearer <API_TOKEN>".
# Make it long and random.
API_TOKEN=change-me-to-a-long-random-string

# Optional: where to persist the pushed config (default ./config.json).
# CONFIG_PATH=config.json
