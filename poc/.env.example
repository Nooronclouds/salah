# Copy this file to ".env" and fill in the values. Never commit the real .env.
#
# Find the SID and Auth Token on your Twilio Console dashboard:
#   https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you were given (Console -> Phone Numbers). E.164 format.
TWILIO_FROM_NUMBER=+15551234567

# The number to call. On a free trial this MUST be a number you've verified
# in the Twilio Console (Verified Caller IDs). Your own phone, in E.164 format.
TO_NUMBER=+919999999999

# Optional: a PUBLIC url to your own adhan mp3. Leave unset to use the built-in
# default clip. Twilio must be able to fetch this URL over the internet.
# ADHAN_AUDIO_URL=https://example.com/adhan.mp3
# And optionally a separate adhan just for Fajr (the one that adds
# "as-salatu khayrun min an-nawm"). Leave unset to use the built-in Fajr default.
# FAJR_ADHAN_URL=https://example.com/fajr-adhan.mp3

# Optional: a spoken line BEFORE the adhan, for the manual test (call_adhan.py).
# Leave unset/empty for pure adhan. If set, it's read in a soothing male voice.
# (The scheduler builds its own per-prayer intro, e.g. "Noor, it's time for Fajr".)
# SPOKEN_INTRO=It is time for prayer


# ---- Scheduler settings (used by scheduler.py) ----------------------------

# Your name, for the spoken intro: "<NAME>, it's time for Fajr". Leave blank to
# just say "It's time for Fajr".
NAME=Noor

# Your location, as decimal coordinates. (Find them by right-clicking your spot
# in Google Maps.)
LATITUDE=17.3850
LONGITUDE=78.4867

# IANA timezone name for your location, e.g. Asia/Kolkata, Asia/Dubai, Europe/London.
TIMEZONE=Asia/Kolkata

# Prayer-time calculation method. One of: KARACHI, MUSLIM_WORLD_LEAGUE, EGYPTIAN,
# UMM_AL_QURA, DUBAI, QATAR, KUWAIT, SINGAPORE, NORTH_AMERICA, MOON_SIGHTING_COMMITTEE, UOIF.
# Pick the one your local mosque/community uses.
CALC_METHOD=KARACHI

# Madhab — affects ASR timing only. HANAFI (later Asr) or SHAFI (earlier).
# Most of India/South Asia is HANAFI.
MADHAB=HANAFI

# Which prayers to be called for, comma-separated. The five obligatory by default.
# Options also include: sunrise (Ishraq). (Tahajjud isn't a fixed clock time, so
# it's handled separately later.)
ENABLED_PRAYERS=fajr,dhuhr,asr,maghrib,isha
